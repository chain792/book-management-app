<%= link_to like_path(current_user.likes.find { |v| v.book_id == book.id }),
            method: :delete,
            remote: true,
            class: "text-red-500 hover:text-red-600" do %>
  <i class="bi bi-heart-fill text-xl"></i>
<% end %>

<span class="ml-1 text-gray-700 font-medium like-count">
  <%= book.likes.length unless book.likes.length.zero? %>
</span>
