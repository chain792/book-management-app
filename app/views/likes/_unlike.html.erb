<%= link_to likes_path(book_id: book.id),
            method: :post,
            remote: true,
            class: "hover:text-red-500" do %>
  <i class="bi bi-heart text-xl text-gray-500"></i>
<% end %>

<span class="ml-1 text-gray-500 like-count">
  <%= book.likes.length unless book.likes.length.zero? %>
</span>
