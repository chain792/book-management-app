<%= form_with model: comment, id: dom_id(comment, :form), data: { action: "turbo:submit-end->comment#afterSubmit" }, class: "space-y-3" do |f| %>
  <%= render Shared::ErrorMessageComponent.new(object: f.object) %>
  <%= render Ui::Form::TextAreaComponent.new(
        form: f, 
        field: :body, 
        data: { "comment-target": "input" },
        class_names: "!text-sm font-medium"
      ) %>
  <div class="flex items-center space-x-2">
    <button type="button" data-action="comment#cancel" class="px-4 py-2 text-xs font-bold text-brand-400 hover:text-brand-600 transition-colors">
      キャンセル
    </button>
    <%= render Ui::ButtonComponent.new(variant: "secondary", type: "submit", class_names: "py-2 px-6 text-xs shadow-md cursor-pointer") do %>
      更新する
    <% end %>
  </div>
<% end %>
