<li class="border-b border-gray-200 pl-2" data-controller="comment">
  <!-- ユーザー情報 -->
  <div class="inline-block">
    <div class="flex items-start">
      <div>
        <%= image_tag comment.user.avatar_url || "default_avatar.png",
          class: "mt-2 ml-1 mr-3 h-10 w-10 rounded-full object-cover" %>
      </div>

      <div>
        <p class="my-1 text-xs font-medium text-gray-900">
          <%= comment.user.name %>
        </p>
        <p class="text-xs text-gray-500">
          <%= l comment.created_at, format: :long %>
        </p>
      </div>
    </div>
  </div>

  <!-- コメント表示 -->
  <div class="ml-1" data-comment-target="view">
    <% if authenticated? && current_user.own?(comment) %>
      <div class="relative float-right mr-3 inline-block text-left" data-controller="dropdown" data-action="click@window->dropdown#hide comment:edit-started@window->comment#closeUnlessSelf">
        <button type="button"
                class="flex items-center text-gray-500 hover:text-gray-700 focus:outline-none" 
                data-action="dropdown#toggle">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
          </svg>
        </button>

        <div data-dropdown-target="menu" 
            class="hidden absolute right-0 z-10 mt-2 w-32 origin-top-right rounded-md bg-white shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none" 
            role="menu" aria-orientation="vertical">
          <div class="py-1" role="none">
            <button type="button" data-action="comment#edit" class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
              編集する
            </button>
            <%= link_to '削除',
                comment_path(comment),
                class: "block px-4 py-2 text-sm text-red-600 hover:bg-gray-100", 
                role: "menuitem",
                data: { 
                  turbo_method: :delete, 
                  turbo_confirm: "コメントを削除しますか?" 
                } %>
          </div>
        </div>
      </div>
    <% end %>

    <div class="mb-1 text-sm text-gray-800" data-comment-target="body">
      <%= simple_format comment.body %>
    </div>
  </div>

  <!-- 編集フォーム -->
  <div class="mr-3 hidden" data-comment-target="form">
    <%= render "comments/edit_form", comment: comment %>
  </div>
</li>
