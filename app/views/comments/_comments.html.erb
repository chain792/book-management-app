<div class="space-y-8">
  <div class="flex items-center space-x-3 px-2">
    <h3 class="text-xl font-black text-brand-900 tracking-tight">
      コメント 
      <span id="comment-count" class="ml-2 text-brand-300 font-bold"><%= comments.length %></span>
    </h3>
    <span class="h-px flex-grow bg-brand-100"></span>
  </div>

  <ol id="comments-list" class="divide-y divide-brand-50">
    <% comments.each do |comment| %>
      <%= render CommentComponent.new(comment: comment, current_user: authenticated? ? current_user : nil) %>
    <% end %>
  </ol>

  <!-- Comment Post Form -->
  <div class="glass p-8 rounded-[2rem] border-none shadow-sm mt-10">
    <%= render 'comments/form', book: book, comment: comment %>
  </div>
</div>
