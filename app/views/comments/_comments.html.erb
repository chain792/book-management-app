<div class="mt-3">
  <div class="mx-auto max-w-5xl px-4">
    <div class="rounded-lg border bg-white">
      <!-- header -->
      <p class="border-b-4 border-yellow-400 px-4 pt-3 pb-2 text-lg font-semibold">
        コメント (<span id="comment-count"><%= comments.length %></span>件)
      </p>

      <!-- コメント一覧 -->
      <ol id="comments-list" class="divide-y">
        <%= render comments %>
      </ol>

      <!-- コメント投稿 -->
      <div class="px-4 pt-3 pb-4">
        <%= render 'comments/form', book: book, comment: comment %>
      </div>
    </div>
  </div>
</div>
