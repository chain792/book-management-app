<%= form_with model: [book, comment], id: 'new-comment', class: "space-y-3" do |f| %>
  <%= render 'shared/error_message', object: f.object %>

  <div>
    <%= f.label :body, 'コメントを残す', class: 'block text-sm font-semibold text-gray-700 mb-1' %>
    <%= f.text_area :body,
          placeholder: 'コメントを追加…',
          id: 'new-comment-body',
          class: 'w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200' %>
  </div>

  <div>
    <%= f.submit t('defaults.post'),
          class: 'inline-flex items-center rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-300' %>
  </div>
<% end %>
