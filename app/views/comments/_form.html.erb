<%= form_with model: [book, comment], id: 'new-comment', class: "space-y-4" do |f| %>
  <%= render Shared::ErrorMessageComponent.new(object: f.object) %>

  <div class="space-y-2">
    <%= render Ui::Form::LabelComponent.new(form: f, field: :body, text: "コメントを残す") %>
    <%= render Ui::Form::TextAreaComponent.new(
          form: f, 
          field: :body, 
          placeholder: "あなたの感想や質問をここに...", 
          id: "new-comment-body"
        ) %>
  </div>

  <div class="flex justify-end">
    <%= render Ui::ButtonComponent.new(type: "submit", class_names: "py-3 px-8 text-sm shadow-lg shadow-brand-500/10 cursor-pointer") do %>
      コメントを投稿
    <% end %>
  </div>
<% end %>
