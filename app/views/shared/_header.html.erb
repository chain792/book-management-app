<header class="sticky top-0 z-50 bg-cyan-500">
  <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
    
    <!-- 左側：ハンバーガーメニュー + ブランド -->
    <div class="flex items-center">
      <!-- ハンバーガーメニュー -->
      <button id="menu-button" class="border border-white p-1 rounded-md mr-3 md:hidden">
        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <!-- ブランド -->
      <%= link_to 'EngineerBook', root_path, class: 'text-white text-xl font-semibold' %>
    </div>

    <!-- ナビゲーションリンク -->
    <div class="hidden md:flex items-center space-x-6">
      <%= link_to '投稿一覧', books_path, class: 'text-white hover:text-gray-200' %>
      <%= link_to 'カテゴリ', categories_path, class: 'text-white hover:text-gray-200' %>
      <%= link_to '新規投稿', search_books_path, class: 'text-white hover:text-gray-200' %>

      <!-- ドロップダウン -->
      <div class="relative">
        <button id="user-menu-button" class="flex items-center focus:outline-none">
          <%= image_tag current_user.avatar.url, size: '40x40', class: 'rounded-full mr-2' %>
        </button>
        <!-- ドロップダウンメニュー -->
        <div id="user-menu" class="hidden absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1">
          <%= link_to 'マイページ', profile_path, class: 'block px-4 py-2 text-gray-700 hover:bg-gray-100' %>
          <%= link_to 'ログアウト', logout_path, data: { turbo_method: :delete }, class: 'block px-4 py-2 text-gray-700 hover:bg-gray-100' %>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  // ドロップダウンの表示切替
  const userMenuButton = document.getElementById('user-menu-button');
  const userMenu = document.getElementById('user-menu');
  userMenuButton?.addEventListener('click', () => {
    userMenu.classList.toggle('hidden');
  });

  // ハンバーガーメニューの簡易オフキャンバス表示
  const menuButton = document.getElementById('menu-button');
  menuButton?.addEventListener('click', () => {
    // ここにモバイルメニューの表示切替処理を追加
    alert('モバイルメニューを表示する処理をここに実装');
  });
</script>
