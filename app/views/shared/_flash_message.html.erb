<% flash.each do |message_type, message| %>
  <% classes = case message_type.to_sym
     when :notice then "bg-blue-100 border border-blue-400 text-blue-700"
     when :alert  then "bg-red-100 border border-red-400 text-red-700"
     else "bg-gray-100 border border-gray-400 text-gray-700"
     end %>
  <div class="<%= classes %> px-4 py-3 rounded-md mb-3">
    <%= message %>
  </div>
<% end %>
