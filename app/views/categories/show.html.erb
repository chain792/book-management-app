<% content_for(:title, @category.name) %>

<div class="space-y-10">
  <!-- Breadcrumb & Header -->
  <div class="space-y-4">
    <nav class="flex px-2 space-x-2 text-[10px] font-bold uppercase tracking-widest text-brand-400">
      <% @category.path.each_with_index do |category, index| %>
        <%= link_to category.name, category_path(category), class: "hover:text-brand-600 transition-colors" %>
        <% unless index == @category.path.length - 1 %>
          <span class="text-brand-200">/</span>
        <% end %>
      <% end %>
    </nav>
    <h1 class="text-4xl font-black text-brand-900 tracking-tight"><%= @category.name %></h1>
  </div>

  <!-- 投稿一覧 -->
  <% if @books.present? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% @books.each do |book| %>
        <%= render BookCardComponent.new(book: book) %>
      <% end %>
    </div>
  <% else %>
    <div class="col-span-full py-24 text-center glass rounded-[2.5rem] border-dashed border-2 border-brand-100">
      <div class="w-16 h-16 bg-brand-50 rounded-full flex items-center justify-center mx-auto mb-6">
        <svg class="w-8 h-8 text-brand-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
      </div>
      <p class="text-brand-500 font-bold">このカテゴリーにはまだレビューがありません。</p>
      <%= link_to '本を検索してレビューを書く', search_books_path, class: 'btn-primary mt-8 inline-block' %>
    </div>
  <% end %>
</div>
