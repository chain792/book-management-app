<% content_for(:title, @category.name) %>

<div class="mx-auto max-w-6xl px-4 pt-3">
  <!-- パンくず -->
  <p class="mb-2 text-xs text-gray-500">
    <% @category.path.each_with_index do |category, index| %>
      <%= link_to category.name,
        category_path(category),
        class: "text-gray-500 hover:text-gray-700 underline" %>
      <%= " › " unless index == @category.path.length - 1 %>
    <% end %>
  </p>

  <!-- タイトル -->
  <h1 class="mb-3 text-2xl font-bold text-gray-900">
    <%= @category.name %>
  </h1>

  <!-- 投稿一覧 -->
  <% if @books.present? %>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% @books.each do |book| %>
        <div>
          <%= render 'books/book', book: book %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="mt-3 text-sm text-gray-500">
      レビューされた本はありません。
    </p>
  <% end %>
</div>
