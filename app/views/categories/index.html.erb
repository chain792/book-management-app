<% content_for(:title, 'カテゴリーを探す') %>

<div class="max-w-4xl mx-auto space-y-12">
  <div class="text-center space-y-2">
    <h1 class="text-3xl font-black text-brand-900 tracking-tight">カテゴリーから探す</h1>
    <p class="text-brand-500 font-medium whitespace-nowrap">あなたの興味にぴったりの本を見つけましょう。</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <% @categories.roots.each do |parent_category| %>
      <div class="glass p-8 rounded-[2rem] border-none shadow-xl hover:shadow-2xl transition-shadow flex flex-col space-y-6">
        <div class="flex items-center justify-between border-b border-brand-50 pb-4">
          <h2 class="text-xl font-black text-brand-900"><%= parent_category.name %></h2>
          <%= link_to category_path(parent_category), class: "text-brand-400 hover:text-brand-600 transition-colors" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          <% end %>
        </div>

        <div class="grid grid-cols-1 gap-3">
          <% parent_category.children.each do |child_category| %>
            <%= link_to child_category.name, category_path(child_category), class: "px-4 py-2 rounded-xl bg-brand-50 text-sm font-bold text-brand-700 hover:bg-brand-600 hover:text-white transition-all shadow-sm" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
