<% content_for(:title, @book.title) %>

<div class="mx-auto mt-3 max-w-5xl px-4">
  <!-- パンくず -->
  <p class="mb-2 text-xs text-gray-500">
    <% @book.category.path.each_with_index do |category, index| %>
      <%= link_to category.name,
        category_path(category),
        class: "text-gray-500 hover:text-gray-700 underline" %>
      <%= " › " unless index == @book.category.path.length - 1 %>
    <% end %>
  </p>

  <!-- タイトル -->
  <h2 class="text-2xl font-bold text-gray-900">
    <%= @book.title %>
  </h2>

  <p class="text-sm text-gray-700">
    <%= "#{@book.authors.pluck(:name).join(', ')} (著)" unless @book.authors.pluck(:name).blank? %>
  </p>

  <p class="text-xs text-gray-500">
    <%= "発売日: #{@book.published_date}" unless @book.published_date.blank? %>
  </p>

  <!-- メインカード -->
  <div class="mb-3 rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
    <div class="flex flex-col gap-4 lg:flex-row">
      <!-- 左：書影 -->
      <div class="w-full lg:w-1/4">
        <%= image_tag @book.book_image.url,
          class: "h-auto max-w-full rounded border" %>

        <p class="mt-3 text-sm">
          <%= link_to '詳細を見る',
            @book.info_link,
            target: '_blank',
            class: "text-blue-600 hover:text-blue-700 underline" %>
        </p>
      </div>

      <!-- 右：情報 -->
      <div class="w-full lg:w-3/4">
        <!-- 操作メニュー -->
        <% if authenticated? && current_user.own?(@book) %>
          <div class="relative inline-block text-left" data-controller="dropdown" data-action="click@window->dropdown#hide">
            <button type="button"
                    class="flex items-center text-gray-500 hover:text-gray-700 focus:outline-none" 
                    data-action="dropdown#toggle">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              </svg>

            </button>

            <div data-dropdown-target="menu" 
                class="hidden absolute right-0 z-10 mt-2 w-48 origin-top-right rounded-md bg-white shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none" 
                role="menu" aria-orientation="vertical">
              <div class="py-1" role="none">
                <%= link_to '編集する', edit_book_path(@book), 
                    class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", role: "menuitem" %>
                
                <%= link_to '削除', book_path(@book), 
                    class: "block px-4 py-2 text-sm text-red-600 hover:bg-gray-100", 
                    role: "menuitem",
                    data: { 
                      turbo_method: :delete, 
                      turbo_confirm: t('defaults.message.delete_confirm', item: t('defaults.review')) 
                    } %>
              </div>
            </div>
          </div>
        <% end %>

        <!-- レビュアー -->
        <div class="mt-3">
          <h5 class="mb-3 inline-block border-b border-gray-300 pb-1 text-sm font-semibold">
            レビュアー
          </h5>

          <%= link_to user_path(@book.user),
            class: "flex items-center gap-3 hover:opacity-80" do %>
            <%= image_tag @book.user.avatar.url,
              class: "h-12 w-12 rounded-full object-cover" %>

            <p class="text-base font-medium text-gray-900">
              <%= @book.user.name %>
            </p>
          <% end %>
        </div>
      </div>
    </div>

    <!-- レビュー内容 -->
    <div class="mt-6">
      <h5 class="mb-2 border-b border-gray-300 pb-1 text-sm font-semibold">
        レビュー内容
      </h5>

      <div class="prose max-w-none text-sm">
        <%= simple_format @book.body %>
      </div>

      <!-- フッター -->
      <div class="mt-3 flex items-center gap-3">
        <p class="text-xs text-gray-500">
          <%= l @book.created_at, format: :long %>
        </p>

        <div class="ml-auto flex items-center gap-3">
          <%= render 'likes/like_button', book: @book %>

          <div>
            <%= render 'books/twitter_share', book: @book %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- コメント -->
  <%= render 'comments/comments',
    comments: @comments,
    comment: @comment,
    book: @book %>
</div>
