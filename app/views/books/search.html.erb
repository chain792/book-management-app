<% content_for(:title, '本検索') %>

<div class="mx-auto max-w-6xl px-4 pt-3">
  <!-- 検索フォーム -->
  <div class="mb-3">
    <div class="mx-auto max-w-3xl">
      <%= form_with url: search_books_path, method: :get do |f| %>
        <div class="mb-3">
          <p class="mb-1 font-bold text-gray-900">
            レビューする本を検索してください
          </p>

          <%= f.search_field :search,
            class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500",
            placeholder: "検索",
            value: params[:search] %>

          <p class="mt-1 text-xs text-gray-500">
            書名・著者等で検索することができます。
          </p>
        </div>

        <%= f.submit '検索',
          class: "rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700" %>
      <% end %>
    </div>
  </div>

  <!-- 検索結果 -->
  <% if @google_books.present? %>
    <div class="mb-3 rounded-md border border-gray-200 bg-white px-3">
      <p class="my-2 font-bold text-gray-900">
        検索結果
        <span class="ml-2 text-xs font-normal text-gray-600">
          キーワード : <%= params[:search] %>
        </span>
      </p>
    </div>

    <!-- カード一覧 -->
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% @google_books['items']&.each do |google_book| %>
        <div>
          <div class="relative mb-3 h-[220px] min-w-[300px] rounded-lg border border-gray-200 bg-white shadow-sm">
            <div class="flex h-full">
              <!-- 画像 -->
              <div class="w-5/12">
                <%= image_tag google_book_thumbnail(google_book),
                  class: "ml-2 mt-2 h-auto max-w-full rounded border" %>
              </div>

              <!-- 本情報 -->
              <div class="w-7/12">
                <div class="p-4">
                  <h5 class="mb-1 text-sm font-semibold text-gray-900">
                    <%= google_book['volumeInfo']['title'].truncate(30) %>
                  </h5>

                  <p class="mb-2 text-xs text-gray-700">
                    <%= google_book['volumeInfo']['authors']&.join(', ')&.truncate(20) %>
                  </p>

                  <p class="text-xs text-gray-500">
                    <%= google_book['volumeInfo']['publishedDate'] %>
                  </p>
                </div>
              </div>
            </div>

            <!-- カード全体リンク -->
            <%= link_to "",
              new_book_path(volumeInfo: set_google_book_params(google_book)),
              class: "absolute inset-0 card-link" %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
