<% content_for(:title, '本を探す') %>

<div class="max-w-4xl mx-auto space-y-12">
  <!-- Search Header -->
  <div class="text-center space-y-4">
    <h1 class="text-3xl font-black text-brand-900 tracking-tight">
      新しく本をレビューする
    </h1>
    <p class="text-brand-500 font-medium max-w-xl mx-auto">
      レビューしたい本をタイトルや著者名で検索してください。<br>
      Google Books から最新の情報を取得します。
    </p>
  </div>

  <!-- Search UI -->
  <div class="glass p-8 rounded-[2rem] border border-brand-100 shadow-2xl">
    <%= form_with url: search_books_path, method: :get, class: "relative" do |f| %>
      <div class="relative group">
        <div class="absolute inset-y-0 left-5 flex items-center pointer-events-none z-10">
          <svg class="w-5 h-5 text-brand-400 group-focus-within:text-brand-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <%= render Ui::Form::InputComponent.new(
              form: f, 
              field: :search, 
              type: "search", 
              placeholder: "本の題、著者名...", 
              class_names: "pl-14 pr-40 py-5 text-lg",
              value: params[:search]
            ) %>
        <div class="absolute inset-y-2 right-2 flex items-center">
          <%= render Ui::ButtonComponent.new(type: "submit", class_names: "h-full px-8 rounded-xl !font-bold") do %>
            検索する
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Results Section -->
  <% if @google_books.present? %>
    <div class="space-y-6">
      <div class="flex items-center space-x-3 px-2">
        <h2 class="text-xl font-bold text-brand-900 italic">"<%= params[:search] %>" の検索結果</h2>
        <span class="h-px flex-grow bg-brand-100"></span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <% @google_books['items']&.each do |google_book| %>
          <%= render Books::GoogleCardComponent.new(google_book: google_book) %>
        <% end %>
      </div>
    </div>
  <% elsif params[:search].present? %>
    <div class="text-center py-20 bg-brand-50 rounded-[2rem] border border-brand-100 border-dashed">
      <p class="text-brand-400 font-bold">見つかりませんでした。別のキーワードを試してみてください。</p>
    </div>
  <% end %>
</div>
