<% content_for(:title, 'レビュー投稿') %>

<div class="mx-auto mt-3 max-w-3xl px-4">
  <h1 class="mb-3 text-2xl font-bold text-gray-900">
    レビュー投稿
  </h1>

  <!-- 本情報カード -->
  <div class="mb-4 rounded-lg border border-gray-200 bg-white p-3 shadow-sm">
    <div class="flex">
      <!-- 画像 -->
      <div class="w-5/12">
        <%= image_tag @volume_info[:bookImage].blank? ? 'sample.png' : @volume_info[:bookImage],
          class: "h-auto max-w-full rounded border" %>
      </div>

      <!-- 本情報 -->
      <div class="w-7/12">
        <div class="p-4">
          <h5 class="mb-1 text-base font-semibold text-gray-900">
            <%= @volume_info[:title] %>
          </h5>

          <p class="mb-2 text-sm text-gray-700">
            <%= @volume_info[:authors]&.join(', ') %>
          </p>

          <p class="mb-2 text-xs text-gray-500">
            <%= @volume_info[:publishedDate] %>
          </p>

          <%= link_to '詳細を見る',
            @volume_info[:infoLink],
            target: '_blank',
            class: "text-sm text-blue-600 hover:text-blue-700 underline" %>
        </div>
      </div>
    </div>
  </div>

  <!-- 投稿フォーム -->
  <%= form_with model: @book, url: books_path, 
      data: { 
        controller: "category-select", 
        category_select_categories_value: @categories.to_json 
      } do |f| %>
    <%= render 'shared/error_message', object: f.object %>

    <!-- 本文 -->
    <div class="mb-4">
      <%= f.label :body,
        class: "mb-1 block text-sm font-bold text-gray-900" %>

      <%= f.text_area :body,
        rows: 5,
        placeholder: "5文字以上で入力してください",
        class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm
               focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500" %>
    </div>

    <!-- カテゴリ選択 -->
    <div class="mb-3" id="category-select-form" data-category-select-target="childContainer">
      <%= f.label :category, class: "mb-1 block text-sm font-bold text-gray-900" %>
      
      <%= f.select :parent_category,
        @parent_category,
        { include_blank: "大カテゴリを選択" },
        { 
          id: "parent_category",
          class: "mb-2 w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-blue-500",
          data: { action: "change->category-select#change" } 
        } %>
    </div>

    <!-- hidden fields -->
    <%= f.hidden_field :title, value: @volume_info[:title] %>
    <%= f.hidden_field :published_date, value: @volume_info[:publishedDate] %>
    <%= f.hidden_field :info_link, value: @volume_info[:infoLink] %>
    <%= f.hidden_field :book_image_remote_url, value: @volume_info[:bookImage] %>

    <% @volume_info[:authors]&.each do |author| %>
      <%= hidden_field_tag 'book[authors][]', author %>
    <% end %>

    <!-- submit -->
    <%= f.submit '登録する', id: "submit-button",
        disabled: true,
        class: "bg-gray-400 text-white px-4 py-2 rounded",
        data: { category_select_target: "submitButton" } %>
  <% end %>
</div>
