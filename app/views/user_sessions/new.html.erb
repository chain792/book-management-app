<% content_for(:title, t('.title')) %>
<div class="max-w-4xl mx-auto mt-6 px-4">
  <h1 class="text-3xl font-bold mb-6 text-center"><%= t '.title' %></h1>

  <div class="md:flex md:space-x-4">
    <!-- ログインフォーム -->
    <div class="bg-white border rounded-xl p-6 pb-10 flex-1 mb-4 md:mb-0">
      <%= form_with url: login_path do |f| %>
        <div class="mb-4">
          <%= f.label :email, User.human_attribute_name(:email), class: 'block font-semibold mb-1' %>
          <%= f.text_field :email, class: 'w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400', placeholder: 'メールアドレスを入力' %>
        </div>

        <div class="mb-4">
          <%= f.label :password, User.human_attribute_name(:password), class: 'block font-semibold mb-1' %>
          <%= f.password_field :password, class: 'w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400', placeholder: 'パスワードを入力' %>
        </div>

        <div class="mb-4">
          <%= f.submit t('defaults.login'), class: 'w-full bg-blue-600 text-white py-2 rounded hover:bg-blue-700' %>
        </div>
      <% end %>

      <p class="text-center font-semibold text-sm my-4">または</p>

      <%= button_to '/auth/twitter', class: 'w-full bg-blue-400 text-white py-2 rounded flex items-center justify-center hover:bg-blue-500' do %>
        <i class="bi bi-twitter mr-2"></i> Twitterでログイン
      <% end %>
    </div>

    <!-- アカウント作成 / ゲストログイン -->
    <div class="bg-white border rounded-xl p-6 pb-10 flex-1 flex flex-col justify-between">
      <div>
        <p class="font-semibold mb-4 border-b pb-2 text-lg">アカウントをお持ちでない方へ</p>

        <div class="mb-6">
          <p class="text-center text-sm mb-2">ゲストユーザとしてログインする</p>
          <%= button_to 'ゲストログイン', guest_login_path, class: 'w-full bg-yellow-400 py-2 rounded hover:bg-yellow-500' %>
        </div>

        <div>
          <p class="text-center text-sm mb-2">新しくアカウントを作成する</p>
          <%= link_to t('.to_register_page'), new_user_path, class: 'w-full border border-blue-600 text-blue-600 py-2 rounded hover:bg-blue-50 block text-center' %>
        </div>
      </div>
    </div>
  </div>
</div>
