<% content_for(:title, @user.name + 'さん') %>
<div class="container mx-auto mt-3 px-3">
  <div class="flex justify-center">
    <div class="w-full md:w-10/12 xl:w-8/12">
      <h1 class="mb-3 text-2xl font-bold"><%= t('.title') %></h1>

      <!-- ユーザ情報 -->
      <div class="bg-white border rounded-xl p-4 min-w-[300px]">
        <div class="flex items-center space-x-4">
          <%= image_tag @user.avatar.url, size: '60x60', class: 'rounded-full' %>
          <div class="flex flex-col md:flex-row md:items-center md:space-x-3">
            <h3 class="text-xl font-semibold"><%= @user.name %></h3>
            <%= render 'relationships/follow_button', user: @user %>
          </div>
        </div>

        <div class="pt-3">
          <p class="border-b font-semibold mb-2">自己紹介</p>
          <p class="whitespace-pre-wrap"><%= simple_format @user.introduction %></p>
        </div>

        <div class="flex space-x-4 mt-2">
          <%= link_to following_user_path(@user), id: 'follow-count', class: 'flex items-center space-x-1 text-decoration-none' do %>
            <span class="text-gray-900 font-semibold"><%= @user.followings.length %></span>
            <small class="text-gray-500">フォロー中</small>
          <% end %>

          <%= link_to follower_user_path(@user), id: 'follower-count', class: 'flex items-center space-x-1 text-decoration-none' do %>
            <span class="text-gray-900 font-semibold"><%= @user.followers.length %></span>
            <small class="text-gray-500">フォロワー</small>
          <% end %>
        </div>
      </div>

      <!-- レビュー履歴 -->
      <div class="bg-white border rounded-xl px-4 mt-3 min-w-[300px]">
        <p class="py-1 my-2 font-semibold">レビュー履歴</p>
      </div>

      <!-- 投稿一覧 -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mt-3">
        <% if @books.present? %>
          <% @books.each do |book| %>
            <%= render 'books/book', book: book %>
          <% end %>
        <% else %>
          <p class="text-gray-500"><%= t('.no_result') %></p>
        <% end %>
      </div>
    </div>
  </div>
</div>
