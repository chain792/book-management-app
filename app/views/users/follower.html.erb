<% content_for(:title, 'フォロワー一覧') %>

<div class="glass p-6 md:p-8 rounded-[2rem] border-none">
  <h1 class="text-2xl font-black text-brand-900 tracking-tight flex items-center">
    <svg class="w-6 h-6 mr-3 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
    </svg>
    <%= @user.name %> さんのフォロワー
  </h1>
</div>

<div class="mt-8 space-y-4">
  <% if @users.present? %>
    <% @users.each do |user| %>
      <%= render UserCardComponent.new(user: user, current_user: current_user) %>
    <% end %>
  <% else %>
    <div class="py-16 text-center glass rounded-[2rem] border-dashed border-2 border-brand-100">
      <p class="text-brand-400 font-bold">フォロワーはいません。</p>
    </div>
  <% end %>
</div>
