<% content_for(:title, t('.title')) %>
<div class="container mx-auto mt-3 px-3">
  <div class="flex justify-center">
    <div class="w-full md:w-10/12 lg:w-8/12">
      <div class="border rounded-lg px-4 mt-3 mb-1 min-w-[300px]">
        <p class="py-1 my-2 font-semibold text-lg"><%= @user.name %> さんがフォローしているユーザ</p>
      </div>

      <% if @users.present? %>
        <%= render @users %>
      <% else %>
        <p class="text-gray-500 mt-3"><%= t('.no_result') %></p>
      <% end %>
    </div>
  </div>
</div>
