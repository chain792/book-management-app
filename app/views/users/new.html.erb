<% content_for(:title, 'エンジニア登録') %>

<div class="max-w-xl mx-auto space-y-10 py-12">
  <div class="text-center space-y-2">
    <h1 class="text-4xl font-black text-brand-900 tracking-tighter">新しく始める</h1>
    <p class="text-brand-500 font-medium">エンジニアのための、最高のレビューコミュニティへようこそ。</p>
  </div>

  <div class="glass p-8 md:p-12 rounded-[2.5rem] border-none shadow-2xl">
    <%= form_with model: @user, class: "space-y-6" do |f| %>
      <%= render 'shared/error_message', object: f.object %>

      <div class="space-y-4">
        <div class="space-y-2">
          <%= render Ui::Form::LabelComponent.new(form: f, field: :name, text: "お名前") %>
          <%= render Ui::Form::InputComponent.new(form: f, field: :name, placeholder: "エンジニア 太郎") %>
        </div>

        <div class="space-y-2">
          <%= render Ui::Form::LabelComponent.new(form: f, field: :email, text: "メールアドレス") %>
          <%= render Ui::Form::InputComponent.new(form: f, field: :email, type: "email", placeholder: "taro@example.com") %>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-2">
            <%= render Ui::Form::LabelComponent.new(form: f, field: :password, text: "パスワード") %>
            <%= render Ui::Form::InputComponent.new(form: f, field: :password, type: "password", placeholder: "••••••••") %>
          </div>
          <div class="space-y-2">
            <%= render Ui::Form::LabelComponent.new(form: f, field: :password_confirmation, text: "確認用") %>
            <%= render Ui::Form::InputComponent.new(form: f, field: :password_confirmation, type: "password", placeholder: "••••••••") %>
          </div>
        </div>
      </div>

      <div class="pt-4">
        <%= render Ui::ButtonComponent.new(type: "submit", class_names: "w-full py-4 shadow-xl shadow-brand-500/20 cursor-pointer") do %>
          アカウントを作成
        <% end %>
      </div>
    <% end %>

    <div class="mt-8 pt-8 border-t border-brand-50 text-center">
      <p class="text-sm font-bold text-brand-400">
        すでにアカウントをお持ちですか？
        <%= link_to 'ログインはこちら', login_path, class: 'text-brand-600 hover:text-brand-900 ml-1 transition-colors underline' %>
      </p>
    </div>
  </div>
</div>
