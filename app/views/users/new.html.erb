<% content_for(:title, t('.title')) %>
<div class="container mx-auto mt-3 px-3">
  <div class="flex justify-center">
    <div class="w-full md:w-10/12 lg:w-8/12">
      <h1 class="mb-3 text-2xl font-bold"><%= t '.title' %></h1>
      <div class="bg-white border rounded-xl p-6">
        <%= form_with model: @user do |f| %>
          <%= render 'shared/error_message', object: f.object %>

          <div class="mb-4">
            <%= f.label :name, class: 'block font-semibold mb-1' %>
            <%= f.text_field :name, class: 'w-full border rounded px-3 py-2', placeholder: '名前を入力' %>
          </div>

          <div class="mb-4">
            <%= f.label :email, class: 'block font-semibold mb-1' %>
            <%= f.email_field :email, class: 'w-full border rounded px-3 py-2', placeholder: 'メールアドレスを入力' %>
          </div>

          <div class="mb-4">
            <%= f.label :password, class: 'block font-semibold mb-1' %>
            <%= f.password_field :password, class: 'w-full border rounded px-3 py-2', placeholder: '半角英数字4文字以上' %>
          </div>

          <div class="mb-4">
            <%= f.label :password_confirmation, class: 'block font-semibold mb-1' %>
            <%= f.password_field :password_confirmation, class: 'w-full border rounded px-3 py-2', placeholder: '半角英数字4文字以上' %>
          </div>

          <%= f.submit t('defaults.register'), class: 'bg-blue-500 hover:bg-blue-600 text-white font-semibold rounded px-4 py-2' %>
        <% end %>

        <div class="text-center mt-4">
          <%= link_to t('.to_login_page'), login_path, class: 'text-blue-500 hover:underline' %>
        </div>
      </div>
    </div>
  </div>
</div>
