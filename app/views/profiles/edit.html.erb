<div class="max-w-2xl mx-auto space-y-10">
  <div class="text-center space-y-2">
    <h1 class="text-3xl font-black text-brand-900 tracking-tight">プロフィール設定</h1>
    <p class="text-brand-500 font-medium">あなたの情報を更新して、より魅力的なプロフィールにしましょう。</p>
  </div>

  <div class="glass p-8 md:p-12 rounded-[2.5rem] border-none shadow-2xl">
    <%= form_with model: @user, url: profile_path, class: "space-y-8" do |f| %>
      <%= render 'shared/error_message', object: f.object %>

      <div class="grid grid-cols-1 gap-8">
        <!-- Avatar Section -->
        <div data-controller="preview" class="flex flex-col items-center space-y-6">
          <div class="relative group">
            <div class="absolute -inset-1 bg-gradient-to-tr from-brand-600 to-accent-500 rounded-full blur opacity-25 group-hover:opacity-50 transition duration-700"></div>
            <%= image_tag @user.avatar_url.presence || "default_avatar.png",
                  data: { preview_target: "preview" },
                  class: 'relative h-32 w-32 rounded-full object-cover border-4 border-white shadow-xl' %>
          </div>
          <div class="flex flex-col items-center">
            <%= render Ui::Form::LabelComponent.new(form: f, field: :avatar, text: "アバター画像を変更", class_names: "cursor-pointer hover:text-brand-900 transition-colors !pl-0") %>
            <%= f.hidden_field :avatar, value: f.object.cached_avatar_data %>
            <%= f.file_field :avatar,
                  accept: 'image/*',
                  data: {
                    preview_target: "input",
                    action: "change->preview#preview"
                  },
                  class: 'hidden' %>
            <p class="text-[10px] text-brand-300 font-bold uppercase tracking-widest mt-2">Recommended: Square image</p>
          </div>
        </div>

        <div class="space-y-6">
          <% if @user.role != 'guest' %>
            <div class="space-y-2">
              <%= render Ui::Form::LabelComponent.new(form: f, field: :email) %>
              <%= render Ui::Form::InputComponent.new(form: f, field: :email, type: "email", placeholder: "your@email.com") %>
            </div>
          <% end %>

          <div class="space-y-2">
            <%= render Ui::Form::LabelComponent.new(form: f, field: :name) %>
            <%= render Ui::Form::InputComponent.new(form: f, field: :name, placeholder: "お名前") %>
          </div>

          <div class="space-y-2">
            <%= render Ui::Form::LabelComponent.new(form: f, field: :introduction) %>
            <%= render Ui::Form::TextAreaComponent.new(form: f, field: :introduction, rows: 4, placeholder: "自己紹介を書きましょう...") %>
          </div>
        </div>
      </div>

      <div class="pt-6 border-t border-brand-50 flex items-center justify-between">
        <%= link_to 'キャンセル', profile_path, class: 'text-sm font-bold text-brand-400 hover:text-brand-600 transition-colors' %>
        <%= render Ui::ButtonComponent.new(type: "submit", class_names: "shadow-xl shadow-brand-500/20 cursor-pointer") do %>
          プロフィールの更新
        <% end %>
      </div>
    <% end %>
  </div>
</div>
