<% content_for(:title, 'プロフィール編集') %>
<div class="mt-3">
  <div class="mx-auto max-w-3xl px-4">
    <h1 class="mb-3 text-2xl font-semibold">プロフィール編集</h1>

    <div class="bg-white border rounded-lg p-6 shadow-sm">
      <%= form_with model: @user, url: profile_path, class: "space-y-5" do |f| %>
        <%= render 'shared/error_message', object: f.object %>

        <% if @user.role != 'guest' %>
          <div>
            <%= f.label :email, class: 'block text-sm font-semibold text-gray-700 mb-1' %>
            <%= f.email_field :email,
                  class: 'w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-200' %>
          </div>
        <% end %>

        <div>
          <%= f.label :name, class: 'block text-sm font-semibold text-gray-700 mb-1' %>
          <%= f.text_field :name,
                class: 'w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-200' %>
        </div>

        <div data-controller="preview">
          <%= f.label :avatar, class: 'block text-sm font-semibold text-gray-700 mb-2' %>
          <div class="flex items-center gap-4">
            <%= image_tag @user.avatar_url || "default_avatar.png",
                  data: { preview_target: "preview" },
                  id: 'preview',
                  class: 'h-20 w-20 rounded-full object-cover',
                  size: '80x80' %>
            <div>
              <%= f.hidden_field :avatar, value: f.object.cached_avatar_data %>
              <%= f.file_field :avatar,
                    id: 'file-field',
                    accept: 'image/*',
                    data: {
                      preview_target: "input",
                      action: "change->preview#preview"
                    },
                    class: 'rounded-md border border-gray-300 px-2 py-1 text-sm' %>
            </div>
          </div>
        </div>

        <div>
          <%= f.label :introduction, class: 'block text-sm font-semibold text-gray-700 mb-1' %>
          <%= f.text_area :introduction,
                rows: 5,
                class: 'w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-200' %>
        </div>

        <div>
          <%= f.submit '更新',
                class: 'rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-300' %>
        </div>
      <% end %>
    </div>
  </div>
</div>
