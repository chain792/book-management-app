<%= render Users::ProfileHeaderComponent.new(user: current_user) %>

<div class="mt-20 space-y-10">
  <div class="flex items-center justify-between px-2">
    <h2 class="text-2xl font-black text-brand-900 tracking-tight flex items-center">
      <svg class="w-6 h-6 mr-3 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
      </svg>
      あなたのレビュー履歴
    </h2>
    <span class="text-sm font-bold text-brand-400"><%= @books.size %> 投稿</span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    <% if @books.present? %>
      <% @books.each do |book| %>
        <%= render Books::CardComponent.new(book: book) %>
      <% end %>
    <% else %>
      <div class="col-span-full py-20 text-center glass rounded-[2rem] border-dashed border-2 border-brand-100">
        <p class="text-brand-400 font-bold">まだレビューした本はありません。</p>
        <%= link_to '最初のレビューを書く', search_books_path, class: 'btn-secondary mt-6 inline-block' %>
      </div>
    <% end %>
  </div>
</div>
