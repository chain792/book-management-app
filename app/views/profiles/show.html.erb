<% content_for(:title, t('.title')) %>

<div class="mt-3">
  <div class="mx-auto max-w-4xl px-4">
    <h1 class="mb-3 text-2xl font-semibold"><%= t('.title') %></h1>

    <!-- ユーザー情報 -->
    <div class="bg-white border rounded-lg p-4 min-w-[300px]">
      <div class="md:flex">
        <%= image_tag current_user.avatar.url,
              size: '60x60',
              class: 'm-3 md:mr-5 rounded-full object-cover' %>

        <div class="flex-1 mt-1 md:mt-0">
          <table class="w-full text-sm">
            <tr>
              <td class="font-semibold text-gray-700"><%= User.human_attribute_name('name') %>:</td>
              <td><%= current_user.name %></td>
            </tr>
            <% if current_user.role != 'guest' %>
              <tr>
                <td class="font-semibold text-gray-700"><%= User.human_attribute_name('email') %>:</td>
                <td><%= current_user.email %></td>
              </tr>
            <% end %>
            <tr>
              <td class="font-semibold text-gray-700">参加日:</td>
              <td><%= date(current_user.created_at) %></td>
            </tr>
          </table>
        </div>
      </div>

      <!-- 自己紹介 -->
      <div class="pt-3">
        <p class="border-b font-semibold text-sm mb-2">自己紹介</p>
        <p class="text-sm"><%= simple_format current_user.introduction %></p>
      </div>

      <!-- フォロー / フォロワー -->
      <div class="flex mb-3 mt-3 gap-6">
        <%= link_to following_user_path(current_user),
                    class: "text-gray-800 hover:text-blue-600 text-sm",
                    id: 'follow-count' do %>
          <span class="font-semibold"><%= current_user.followings.length %></span>
          <span class="text-gray-500">フォロー中</span>
        <% end %>

        <%= link_to follower_user_path(current_user),
                    class: "text-gray-800 hover:text-blue-600 text-sm",
                    id: 'follower-count' do %>
          <span class="font-semibold"><%= current_user.followers.length %></span>
          <span class="text-gray-500">フォロワー</span>
        <% end %>
      </div>

      <%= link_to t('defaults.edit'),
                  edit_profile_path,
                  class: 'inline-block rounded-md bg-blue-600 px-4 py-2 text-white text-sm font-semibold hover:bg-blue-700' %>
    </div>

    <!-- レビュー履歴ヘッダー -->
    <div class="bg-white border rounded-lg px-4 mt-3 min-w-[300px]">
      <p class="pt-3 font-semibold text-lg">レビュー履歴</p>
    </div>

    <!-- 投稿一覧 -->
    <div class="mt-3 grid gap-4 lg:grid-cols-2 grid-cols-1">
      <% if @books.present? %>
        <% @books.each do |book| %>
          <div>
            <%= render 'books/book', book: book %>
          </div>
        <% end %>
      <% else %>
        <p class="text-gray-500 text-sm"><%= t('.no_result') %></p>
      <% end %>
    </div>
  </div>
</div>
