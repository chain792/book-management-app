<div class="space-y-8" data-testid="book-details">
  <!-- Breadcrumb -->
  <nav class="flex px-2 space-x-2 text-[10px] font-bold uppercase tracking-widest text-brand-400">
    <% category_path.each_with_index do |category, index| %>
      <%= link_to category.name, helpers.category_path(category), class: "hover:text-brand-600 transition-colors" %>
      <% unless index == category_path.size - 1 %>
        <span class="text-brand-200">/</span>
      <% end %>
    <% end %>
  </nav>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
    <!-- Left: Book Image (Floating Effect) -->
    <div class="lg:col-span-4 group">
      <div class="sticky top-28 space-y-6 text-center lg:text-left">
        <div class="relative inline-block lg:block">
          <div class="absolute -inset-4 bg-brand-500/10 blur-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
          <%= image_tag book_image, class: "relative w-64 lg:w-full h-auto mx-auto rounded-3xl shadow-2xl border border-brand-100 p-6 bg-white transition-transform duration-500 group-hover:scale-[1.02]" %>
        </div>
        
        <%= render Ui::ButtonComponent.new(variant: "secondary", class_names: "w-full justify-center flex items-center group/link", onclick: "window.open('#{book.info_link}', '_blank')") do %>
          詳細を見る（Google Books）
          <svg class="w-4 h-4 ml-2 group-hover/link:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        <% end %>
      </div>
    </div>

    <!-- Right: Details -->
    <div class="lg:col-span-8 space-y-10">
      <div class="space-y-4">
        <div class="flex items-start justify-between gap-4">
          <h1 class="text-4xl font-black text-brand-900 tracking-tight leading-tight">
            <%= book.title %>
          </h1>

          <% if own_book? %>
            <div class="relative flex-shrink-0" data-controller="dropdown" data-testid="book-actions">
              <button data-action="click->dropdown#toggle click@window->dropdown#close" class="p-2 text-brand-300 hover:text-brand-600 border border-brand-50 rounded-xl hover:bg-brand-50 transition-all">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z" />
                </svg>
              </button>
              <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-48 bg-white glass rounded-2xl shadow-2xl border border-brand-100 py-2 z-20">
                <%= link_to edit_book_path(book), class: 'flex items-center px-4 py-2 text-sm text-brand-700 hover:bg-brand-50' do %>
                  編集する
                <% end %>
                <%= link_to book_path(book), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: 'flex items-center px-4 py-2 text-sm text-red-600 hover:bg-red-50' do %>
                  削除する
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <p class="text-xl font-bold text-brand-500">
          <%= authors_list %>
        </p>
        <p class="text-xs font-bold text-brand-300 uppercase tracking-widest">
          発売日: <%= book.published_date.presence || "不明" %>
        </p>
      </div>

      <!-- Review Content -->
      <div class="glass p-8 rounded-[2rem] border-none shadow-indigo-100/50">
        <div class="flex items-center space-x-4 mb-6">
          <%= image_tag book.user.avatar_url.presence || "default_avatar.png", class: "w-12 h-12 rounded-full border-2 border-brand-100 object-cover shadow-sm" %>
          <div>
            <p class="text-xs text-brand-400 font-bold uppercase tracking-wider mb-0.5">Reviewed by</p>
            <%= link_to book.user.name, user_path(book.user), class: "text-base font-black text-brand-900 hover:text-brand-600 transition-colors" %>
          </div>
          <div class="ml-auto flex flex-col items-end text-[10px] font-bold text-brand-300">
            <span><%= helpers.date_ago(book.created_at) %></span>
            <span><%= helpers.l book.created_at, format: :long %></span>
          </div>
        </div>

        <div class="prose prose-brand max-w-none text-brand-800 leading-relaxed font-medium">
          <%= helpers.simple_format book.body %>
        </div>

        <!-- Meta info -->
        <div class="mt-10 pt-8 border-t border-brand-50 flex items-center justify-between">
          <div class="flex items-center space-x-6">
            <%= render 'likes/like_button', book: book %>
            <div class="flex items-center text-brand-400 text-xs font-bold">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
              <%= book.comments.size %> コメント
            </div>
          </div>
          
          <%= render 'books/twitter_share', book: book %>
        </div>
      </div>
    </div>
  </div>
</div>
