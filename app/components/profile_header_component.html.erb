<div class="glass p-8 md:p-12 rounded-[3rem] border-none shadow-indigo-100/50 relative overflow-hidden">
  <!-- Background Accent -->
  <div class="absolute -top-24 -right-24 w-64 h-64 bg-brand-500/5 blur-3xl rounded-full"></div>
  
  <div class="relative flex flex-col md:flex-row items-center md:items-start space-y-8 md:space-y-0 md:space-x-12">
    <!-- Avatar Section -->
    <div class="relative group">
      <div class="absolute -inset-1 bg-gradient-to-tr from-brand-600 to-accent-500 rounded-full blur opacity-25 group-hover:opacity-50 transition duration-1000"></div>
      <%= image_tag user.avatar_url.presence || "default_avatar.png", class: "relative w-32 h-32 md:w-40 md:h-40 rounded-full border-4 border-white object-cover shadow-2xl" %>
    </div>

    <!-- Info Section -->
    <div class="flex-grow text-center md:text-left space-y-6">
      <div class="space-y-2">
        <h1 class="text-3xl md:text-5xl font-black text-brand-900 tracking-tight">
          <%= user.name %>
        </h1>
        <div class="flex items-center justify-center md:justify-start space-x-4 text-xs font-bold text-brand-400 uppercase tracking-widest">
          <% if user.role != 'guest' %>
            <span class="flex items-center">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <%= user.email %>
            </span>
          <% end %>
          <span class="flex items-center">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            Member since <%= helpers.date(user.created_at) %>
          </span>
        </div>
      </div>

      <% if user.introduction.present? %>
        <div class="max-w-xl">
          <p class="text-brand-600 leading-relaxed font-medium">
            <%= helpers.simple_format user.introduction %>
          </p>
        </div>
      <% end %>

      <!-- Stats & Actions -->
      <div class="flex flex-col sm:flex-row items-center space-y-6 sm:space-y-0 sm:space-x-8 pt-4">
        <div class="flex items-center space-x-6">
          <%= link_to following_user_path(user), class: "group/stat" do %>
            <div class="text-center md:text-left">
              <span class="block text-2xl font-black text-brand-900 group-hover/stat:text-brand-600 transition-colors"><%= following_count %></span>
              <span class="text-[10px] font-bold text-brand-300 uppercase tracking-widest">Following</span>
            </div>
          <% end %>
          <%= link_to follower_user_path(user), class: "group/stat" do %>
            <div class="text-center md:text-left">
              <span class="block text-2xl font-black text-brand-900 group-hover/stat:text-brand-600 transition-colors"><%= follower_count %></span>
              <span class="text-[10px] font-bold text-brand-300 uppercase tracking-widest">Followers</span>
            </div>
          <% end %>
        </div>

        <div class="flex items-center space-x-3 w-full sm:w-auto">
          <%= render Ui::ButtonComponent.new(variant: "primary", class_names: "w-full sm:w-auto text-sm justify-center flex items-center", onclick: "location.href='#{helpers.edit_profile_path}'") do %>
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
            編集する
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
