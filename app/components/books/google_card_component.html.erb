<div class="group relative flex bg-white rounded-2xl border border-brand-100 overflow-hidden shadow-sm card-hover h-32">
  <!-- Image -->
  <div class="w-1/3 min-w-[100px] bg-brand-50 p-2 flex items-center justify-center">
    <%= image_tag thumbnail_url, class: "h-full w-auto object-contain transition-transform duration-500 group-hover:scale-105" %>
  </div>

  <!-- Info -->
  <div class="flex-grow p-4 flex flex-col justify-center min-w-0">
    <h3 class="text-xs font-bold text-brand-900 leading-snug truncate mb-1">
      <%= title %>
    </h3>
    <p class="text-[10px] text-brand-600 truncate mb-1">
      <%= authors %>
    </p>
    <p class="text-[10px] text-brand-400 font-medium">
      <%= published_date %>
    </p>
  </div>

  <!-- Action Overlay -->
  <div class="absolute inset-y-0 right-4 flex items-center opacity-0 group-hover:opacity-100 transition-opacity">
    <div class="bg-brand-600 text-white p-2 rounded-full shadow-lg">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
    </div>
  </div>

  <%= link_to "", new_book_path_with_params, class: "absolute inset-0" %>
</div>
