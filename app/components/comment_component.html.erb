<li class="group py-6 first:pt-2" data-controller="comment">
  <div class="flex items-start space-x-4">
    <!-- Avatar -->
    <div class="flex-shrink-0">
      <%= image_tag author.avatar_url.presence || "default_avatar.png", class: "w-10 h-10 rounded-full border border-brand-100 object-cover shadow-sm" %>
    </div>

    <!-- Content -->
    <div class="flex-grow space-y-2">
      <div class="flex items-center justify-between">
        <div class="flex flex-col">
          <span class="text-sm font-black text-brand-900 leading-none mb-1"><%= author.name %></span>
          <span class="text-[10px] font-bold text-brand-300 uppercase tracking-widest"><%= helpers.date_ago(comment.created_at) %></span>
        </div>

        <% if own_comment? %>
          <% action_visibility = Rails.env.test? ? "" : "opacity-0 group-hover:opacity-100" %>
          <div data-comment-target="view" class="flex-shrink-0 ml-4 <%= action_visibility %> transition-opacity">
            <div class="relative" data-controller="dropdown">
              <button data-action="click->dropdown#toggle click@window->dropdown#close" class="p-1.5 text-brand-300 hover:text-brand-600 hover:bg-brand-50 rounded-lg transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z" />
                </svg>
              </button>
              <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-32 bg-white glass rounded-xl shadow-2xl border border-brand-100 py-1 z-20">
                <button type="button" data-action="comment#edit" class="w-full text-left px-4 py-2 text-xs font-bold text-brand-700 hover:bg-brand-50">
                  編集する
                </button>
                <%= link_to '削除する', comment_path(comment), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: 'block px-4 py-2 text-xs font-bold text-red-600 hover:bg-red-50' %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <div data-comment-target="view body" class="text-sm text-brand-700 font-medium leading-relaxed">
        <%= helpers.simple_format comment.body %>
      </div>

      <!-- Edit Form (Hidden by default) -->
      <div data-comment-target="form" class="hidden">
        <%= render "comments/edit_form", comment: comment %>
      </div>
    </div>
  </div>
</li>
