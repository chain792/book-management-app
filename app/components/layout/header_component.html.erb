<header class="glass sticky top-0 z-50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    
    <!-- Branding -->
    <div class="flex items-center group">
      <%= link_to root_path, class: "flex items-center space-x-2" do %>
        <div class="w-8 h-8 bg-brand-600 rounded-lg flex items-center justify-center shadow-lg group-hover:bg-brand-500 transition-colors">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </div>
        <span class="text-xl font-bold tracking-tight text-brand-900 group-hover:text-brand-600 transition-colors">
          EngineerBook
        </span>
      <% end %>
    </div>

    <!-- Navigation -->
    <nav class="hidden md:flex items-center space-x-8">
      <%= link_to '投稿一覧', helpers.books_path, class: 'text-sm font-medium text-brand-700 hover:text-brand-900 transition-colors' %>
      <%= link_to 'カテゴリ', helpers.categories_path, class: 'text-sm font-medium text-brand-700 hover:text-brand-900 transition-colors' %>
      
      <% if authenticated? %>
        <%= render Ui::ButtonComponent.new(size: "sm", class_names: "text-xs", onclick: "location.href='#{helpers.search_books_path}'") do %>
          <div class="flex items-center space-x-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            <span>新規投稿</span>
          </div>
        <% end %>

        <!-- User Menu -->
        <div class="relative" data-controller="dropdown">
          <button data-action="click->dropdown#toggle click@window->dropdown#close" class="flex items-center space-x-2 focus:outline-none focus:ring-2 focus:ring-brand-200 rounded-full p-0.5 transition-all">
            <%= image_tag current_user&.avatar_url || "default_avatar.png", class: "w-8 h-8 rounded-full border border-brand-200 shadow-sm" %>
            <svg class="w-4 h-4 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          
          <div data-dropdown-target="menu" class="hidden absolute right-0 mt-3 w-56 bg-white rounded-2xl shadow-2xl border border-brand-100 py-2 origin-top-right transition-all">
            <div class="px-4 py-2 border-b border-brand-50 mb-1">
              <p class="text-xs text-brand-400">ログイン中</p>
              <p class="text-sm font-bold text-brand-900 truncate"><%= current_user&.name %></p>
            </div>
            <%= link_to helpers.profile_path, class: 'flex items-center px-4 py-2 text-sm text-brand-700 hover:bg-brand-50 transition-colors' do %>
              <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              マイページ
            <% end %>
            <%= link_to helpers.logout_path, data: { turbo_method: :delete }, class: 'flex items-center px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition-colors' do %>
              <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
              </svg>
              ログアウト
            <% end %>
          </div>
        </div>
      <% else %>
        <%= link_to 'ログイン', helpers.login_path, class: 'text-sm font-medium text-brand-700 hover:text-brand-900' %>
        <%= render Ui::ButtonComponent.new(size: "sm", class_names: "text-xs", onclick: "location.href='#{helpers.new_user_path}'") do %>
          サインアップ
        <% end %>
      <% end %>
    </nav>

    <!-- Mobile Menu Button -->
    <button class="md:hidden p-2 text-brand-600">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
      </svg>
    </button>
  </div>
</header>
