<div class="fixed top-24 right-6 z-[60] flex flex-col space-y-3 pointer-events-none">
  <% flash.each do |type, message| %>
    <% 
      config = case type.to_sym
               when :notice then { bg: "bg-emerald-50", border: "border-emerald-200", text: "text-emerald-800", icon: "M5 13l4 4L19 7" }
               when :alert  then { bg: "bg-rose-50", border: "border-rose-200", text: "text-rose-800", icon: "M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.268 14c-.77 1.333.192 3 1.732 3z" }
               else { bg: "bg-blue-50", border: "border-blue-200", text: "text-blue-800", icon: "M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" }
               end
    %>
    <div class="pointer-events-auto flex items-center p-4 rounded-2xl glass <%= config[:bg] %> <%= config[:border] %> shadow-2xl min-w-[320px] animate-in slide-in-from-right duration-500">
      <div class="flex-shrink-0 w-10 h-10 rounded-full bg-white flex items-center justify-center shadow-sm mr-4">
        <svg class="w-5 h-5 <%= config[:text] %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= config[:icon] %>" />
        </svg>
      </div>
      <div class="text-sm font-semibold <%= config[:text] %>">
        <%= message %>
      </div>
    </div>
  <% end %>
</div>
