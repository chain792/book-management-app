<div class="group relative flex flex-col bg-white rounded-3xl border border-brand-100 overflow-hidden shadow-sm card-hover h-full">
  <!-- Image Section -->
  <div class="relative aspect-[4/3] overflow-hidden bg-brand-50">
    <%= image_tag book_image, class: "w-full h-full object-contain p-4 transition-transform duration-500 group-hover:scale-105" %>
    <div class="absolute top-4 left-4">
      <span class="px-3 py-1 bg-white/90 backdrop-blur-sm text-[10px] font-bold uppercase tracking-wider text-brand-600 rounded-full border border-brand-100 shadow-sm">
        <%= category_name %>
      </span>
    </div>
  </div>

  <!-- Content Section -->
  <div class="flex flex-col flex-grow p-6">
    <div class="flex items-center space-x-3 mb-4">
      <%= image_tag user_avatar, class: "w-8 h-8 rounded-full border border-brand-100 object-cover" %>
      <div class="flex flex-col">
        <span class="text-xs font-bold text-brand-900 leading-none mb-1"><%= user_name %></span>
        <span class="text-[10px] text-brand-400 font-medium"><%= helpers.date_ago(book.created_at) %></span>
      </div>
    </div>

    <h3 class="text-lg font-bold text-brand-900 leading-tight mb-3 group-hover:text-brand-600 transition-colors">
      <%= book.title.truncate(45) %>
    </h3>

    <div class="flex-grow">
      <p class="text-sm text-brand-600 line-clamp-3 mb-4">
        <%= book.body %>
      </p>
    </div>

    <div class="flex items-center justify-between pt-4 border-t border-brand-50 mt-auto">
      <div class="flex items-center space-x-4">
        <div class="flex items-center text-brand-400 text-xs">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
          <%= book.comments.size %>
        </div>
        <div class="flex items-center text-brand-400 text-xs">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
          <%= book.likes.size %>
        </div>
      </div>
      
      <span class="text-xs font-bold text-brand-500 group-hover:translate-x-1 transition-transform inline-flex items-center">
        詳細を見る
        <svg class="w-3 h-3 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </span>
    </div>
  </div>

  <%= link_to "", book_path(book), class: "absolute inset-0 z-10" %>
</div>
